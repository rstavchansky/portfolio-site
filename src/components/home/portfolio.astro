---
import { getCollection } from "astro:content";
import Button from "../button.astro";
import PortfolioCard from "../portfolio-card.astro";

const allItems = await getCollection("portfolio");
const featured = allItems.slice(0, 3);
---

<section class="max-w-4xl mx-auto px-7 lg:px-0">
  <h2
    class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
  >
    My Portfolio
  </h2>
  <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
    A selection of technical documentation, software guides, and team management resources.
  </p>
  <div
    class="grid items-stretch w-full grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-7 mt-7"
  >
    {
      featured.map((item) => {
        return (
          <PortfolioCard
            title={item.data.title}
            description={item.data.description}
            thumbnail={item.data.thumbnail}
            url={`/portfolio/${item.slug}`}
          />
        )
      })
    }
  </div>

  <div class="flex items-center justify-center w-full py-5">
    <Button text="View All Portfolio" link="/portfolio" />
  </div>
</section>
